{
  "name": "tawakkal-personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Single-page personal portfolio built with HTML, Tailwind CSS, and Vanilla JavaScript.",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\"",
    "watch:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/styles.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./src/css/input.css -o ./assets/css/styles.css --minify",
    "serve": "http-server . -p 5500 -c-1 -o",
    "build": "npm run build:css && node scripts/build.mjs",
    "preview": "http-server ./dist -p 5501 -c-1 -o"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "concurrently": "9.2.1",
    "http-server": "14.1.1",
    "tailwindcss": "4.3.4"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
